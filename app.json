{
  "expo": {
    "name": "BumpJourney",
    "slug": "BumpJourney",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "bumpjourney",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/86c7eaa4-16dc-4114-b739-0548415ef544"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.bumpjourney.app",
      "adaptiveIcon": {
        "backgroundColor": "#CE4F7A",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bumpjourney-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAE3EA",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "86c7eaa4-16dc-4114-b739-0548415ef544"
      }
    },
    "owner": "hilalhk"
  }
}
