{
  "expo": {
    "name": "BumpJourney",
    "slug": "BumpJourney",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bumpjourney-logo.png",
    "scheme": "bumpjourney",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.bumpjourney.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAE3EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bumpjourney-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAE3EA",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "86c7eaa4-16dc-4114-b739-0548415ef544"
      }
    },
    "owner": "hilalhk"
  }
}
